{
  "name": "@qwen-code/test-failure-explorer",
  "version": "0.25.3",
  "private": true,
  "description": "Workspace-bound queries over immutable Vitest JSON reports",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenLM/qwen-code.git",
    "directory": "integrations/test-failure-explorer"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src scripts",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "test:ci": "npm run build && vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/main.js",
    "dist/app.html",
    "qwen-extension.json",
    "README.md",
    "skills"
  ],
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4",
    "zod": "^3.25.0"
  }
}
