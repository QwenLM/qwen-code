{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "exec '/absolute/path/to/node' '/administrator/path/to/external-context-mem0/dist/auto-recall.js'",
            "timeout": 8000,
            "name": "external-context-mem0-auto-recall",
            "statusMessage": "Retrieving external context"
          }
        ]
      }
    ]
  },
  "$version": 4
}
