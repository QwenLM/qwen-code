{
  "name": "qwen-code",
  "version": "1.0.0",
  "private": true,
  "description": "Shared CLI and agent runtime for internal development",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node packages/cli/dist/bin.js",
    "generate": "node scripts/generate-git-commit-info.js",
    "schema:settings": "tsx ./scripts/generate-settings-schema.ts",
    "build": "node scripts/build.js",
    "prebuild": "npm run patch:dependencies",
    "patch:dependencies": "patch-package --error-on-fail",
    "check:lockfile": "node scripts/check-lockfile.js",
    "test": "node scripts/root-test-guard.js",
    "test:ci": "npm run test:ci --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:bun:binary": "bun run scripts/build_qwen_bun_binary.ts"
  },
  "overrides": {
    "@anthropic-ai/sdk": "^0.81.0",
    "brace-expansion@5": "^5.0.9",
    "wrap-ansi": "9.0.2",
    "cliui": {
      "wrap-ansi": "7.0.0"
    },
    "glob": "^12.0.0",
    "node-domexception": "npm:empty@^0.10.1",
    "prebuild-install": "npm:nop@1.0.0",
    "vite-plus": "npm:nop@1.0.0",
    "cross-spawn": "^7.0.6",
    "minimatch": "^10.2.2",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@qwen-code/core": "file:packages/core",
    "@octokit/rest": "^22.0.0",
    "@types/marked": "^5.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/minimatch": "^5.1.2",
    "@types/mock-fs": "^4.13.4",
    "@types/prompts": "^2.4.9",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^7.0.3",
    "domexception": "^4.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-wasm": "^1.1.0",
    "eslint-plugin-import": "^2.32.0",
    "glob": "^12.0.0",
    "json": "^11.0.0",
    "memfs": "^4.42.0",
    "mnemonist": "^0.40.3",
    "mock-fs": "^5.5.0",
    "msw": "^2.10.4",
    "npm-run-all": "^4.1.5",
    "oxlint": "1.78.0",
    "oxlint-plugin-eslint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "patch-package": "8.0.1",
    "prettier": "3.6.1",
    "react-devtools-core": "^7.0.1",
    "react-dom": "^19.2.0",
    "read-package-up": "^11.0.0",
    "resedit": "^3.0.2",
    "semver": "^7.7.2",
    "strip-ansi": "^7.1.2",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "yargs": "^17.7.2"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/qrcode": "^1.5.6",
    "bidi-js": "^1.0.3",
    "ink": "file:packages/ink-shim",
    "latest-version": "^9.0.0",
    "lodash-es": "^4.18.1",
    "node-fetch-native": "^1.6.7",
    "proper-lockfile": "^4.1.2",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "simple-git": "^3.28.0",
    "turndown": "^7.2.4",
    "usehooks-ts": "^3.1.1"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
