<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.alibaba</groupId>
        <artifactId>qwen-managed-agent-parent</artifactId>
        <version>0.1.0-alpha</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>qwen-managed-agent-server</artifactId>
    <name>Qwen Managed Agent Server</name>
    <properties>
        <managed.module.root>${project.basedir}/..</managed.module.root>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>qwen-managed-agent-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>qwen-managed-agent-control-plane</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>qwen-managed-agent-runtime-broker</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>qwen-managed-agent-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>qwen-managed-agent-adapters</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>com.zaxxer</groupId>
                    <artifactId>HikariCP</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Writes META-INF/spring-configuration-metadata.json, from
                         which docs/users/managed-agent-configuration-reference.md
                         is generated. Only ManagedAgentProperties: the two Druid
                         beans share a prefix, which the processor refuses. It
                         reads Lombok's annotations itself. -->
                    <execution>
                        <id>configuration-metadata</id>
                        <phase>process-classes</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <proc>only</proc>
                            <includes>
                                <include>com/alibaba/qwen/code/managedagent/config/ManagedAgentProperties.java</include>
                            </includes>
                            <annotationProcessorPaths combine.self="override">
                                <path>
                                    <groupId>org.springframework.boot</groupId>
                                    <artifactId>spring-boot-configuration-processor</artifactId>
                                    <version>${spring-boot.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <excludes>
                                <exclude>application*.yml</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>workspace-bundle-resources</id>
                        <phase>${managed.operator-tools.jar.phase}</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>workspace-bundle</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>workspace-migration-resources</id>
                        <phase>${managed.operator-tools.jar.phase}</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>workspace-migration</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>workspace-maintenance-recovery-resources</id>
                        <phase>${managed.operator-tools.jar.phase}</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>workspace-maintenance-recovery</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>csi-session-resources</id>
                        <phase>${managed.operator-tools.jar.phase}</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>csi-session</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>csi-runtime-resources</id>
                        <phase>${managed.operator-tools.jar.phase}</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>csi-runtime</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>operator-recovery-resources</id>
                        <phase>${managed.operator-tools.jar.phase}</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>operator-recovery</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>standalone-resources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <configuration>
                            <classifier>exec</classifier>
                            <mainClass>com.alibaba.qwen.code.managedagent.ManagedAgentServerApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>workspace-bundle</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>workspace-bundle</classifier>
                            <attach>${managed.operator-tools.attach}</attach>
                            <skip>${managed.operator-tools.skip}</skip>
                            <mainClass>com.alibaba.qwen.code.managedagent.maintenance.WorkspaceRecoveryMain</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>workspace-migration</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>workspace-migration</classifier>
                            <attach>${managed.operator-tools.attach}</attach>
                            <skip>${managed.operator-tools.skip}</skip>
                            <mainClass>com.alibaba.qwen.code.managedagent.maintenance.WorkspaceMigrationMain</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>workspace-maintenance-recovery</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>workspace-maintenance-recovery</classifier>
                            <attach>${managed.operator-tools.attach}</attach>
                            <skip>${managed.operator-tools.skip}</skip>
                            <mainClass>com.alibaba.qwen.code.managedagent.maintenance.WorkspaceMaintenanceRecoveryMain</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>csi-session</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>csi-session</classifier>
                            <attach>${managed.operator-tools.attach}</attach>
                            <skip>${managed.operator-tools.skip}</skip>
                            <mainClass>com.alibaba.qwen.code.managedagent.maintenance.WorkspaceCsiSessionMain</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>csi-runtime</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>csi-runtime</classifier>
                            <attach>${managed.operator-tools.attach}</attach>
                            <skip>${managed.operator-tools.skip}</skip>
                            <mainClass>com.alibaba.qwen.code.managedagent.maintenance.WorkspaceCsiRuntimeMain</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>operator-recovery</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>operator-recovery</classifier>
                            <attach>${managed.operator-tools.attach}</attach>
                            <skip>${managed.operator-tools.skip}</skip>
                            <mainClass>com.alibaba.qwen.code.managedagent.maintenance.WorkspaceRecoveryCommand</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
