# Hosted Harness credentials. The control plane reads this file through
# QWEN_MANAGED_AGENT_HARNESS_CREDENTIALS_FILE in server.env, so write each
# credential as KEY=value on one line with LF endings, no whitespace around
# `=`, and only letters, digits and ._:/+=- in the value (the Broker URL below
# may also use [ and ] to bracket an IPv6 literal, as in http://[::1]:4182),
# and start comments with `#`: systemd and a shell read anything else
# differently, so the control plane refuses it.
QWEN_SERVER_TOKEN=replace-with-a-private-random-token
QWEN_HOSTED_HARNESS_CAPABILITY_DIGEST=sha256:replace-with-64-lowercase-hex
# Tool path: the Runtime Broker the Harness calls. The control plane reads the
# same token from this file. Uncomment both together; they replace the old
# QWEN_HOSTED_HARNESS_BROKER_ARGS line, which nothing reads any more.
# QWEN_MANAGED_RUNTIME_BROKER_URL=http://127.0.0.1:4182
# QWEN_MANAGED_RUNTIME_BROKER_TOKEN=replace-with-a-private-random-token
