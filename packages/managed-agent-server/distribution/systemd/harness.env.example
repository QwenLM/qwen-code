# Hosted Harness credentials. Keep the same values in server.env.
QWEN_SERVER_TOKEN=replace-with-a-private-random-token
QWEN_HOSTED_HARNESS_CAPABILITY_DIGEST=sha256:replace-with-64-lowercase-hex
# Tool path only: these options have no environment fallback in the CLI.
# QWEN_HOSTED_HARNESS_BROKER_ARGS=--managed-runtime-broker-url=http://127.0.0.1:4182 --managed-runtime-broker-token=<broker-token>
