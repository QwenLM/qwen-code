SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/qwen_managed_agent
SPRING_DATASOURCE_USERNAME=qwen
SPRING_DATASOURCE_PASSWORD=replace-me
QWEN_MANAGED_AGENT_HARNESS_ENABLED=true
QWEN_MANAGED_AGENT_HARNESS_BASE_URL=http://127.0.0.1:4170
QWEN_MANAGED_AGENT_HARNESS_TOKEN=replace-with-the-harness-token
QWEN_MANAGED_AGENT_CAPABILITY_DIGEST=sha256:replace-with-the-same-digest
# The Harness enables the Managed Session Store on this server's loopback
# listener. Its workspace ID derives from this existing directory, as the
# Runtime Broker's does; keep an existing QWEN_MANAGED_AGENT_WORKSPACE_ID.
QWEN_MANAGED_AGENT_WORKSPACE_CWD=/srv/qwen-workspace
# The Runtime credential key ring cannot come from the environment.
SPRING_CONFIG_ADDITIONAL_LOCATION=file:/etc/qwen-managed-agent/application.yml
# Tool path. Uncomment only after the Workspace and key ring are configured.
# QWEN_MANAGED_AGENT_RUNTIME_BROKER_ENABLED=true
# QWEN_MANAGED_AGENT_RUNTIME_BROKER_TOKEN=replace-with-a-private-token
# QWEN_MANAGED_AGENT_RUNTIME_CREDENTIAL_KEY_ID=reference-v1
# QWEN_MANAGED_AGENT_RUNTIME_CREDENTIAL_KEY=replace-with-base64-32-bytes
# QWEN_MANAGED_AGENT_RUNTIME_STATE_DIRECTORY=/var/lib/qwen-managed-agent/runtime
# QWEN_MANAGED_AGENT_NODE_EXECUTABLE=/usr/bin/node
# QWEN_MANAGED_AGENT_RUNTIME_WORKER_ENTRY=/usr/local/lib/node_modules/@qwen-code/qwen-code/dist/cli.js
# QWEN_MANAGED_AGENT_RUNTIME_VERIFIED_WORKSPACE_RECOVERY_ENABLED=true
