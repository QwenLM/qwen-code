{
  "name": "@qwen-code/desktop-electron",
  "version": "0.0.1",
  "description": "Independent Qwen Code Electron desktop preview built with Web Shell",
  "author": "Qwen Team",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "npm run build:app && electron .",
    "start": "electron .",
    "build": "npm run build:runtime && npm run build:app && electron-builder",
    "build:app": "npm run build:main",
    "build:main": "node scripts/build-main.js",
    "build:runtime": "node scripts/prepare-runtime.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:runtime": "node scripts/smoke-runtime.js",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "test:release": "node scripts/test-release.js",
    "version": "node scripts/version.js",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.alibaba.qwen-code.electron-preview",
    "productName": "Qwen Code Desktop Electron Preview",
    "executableName": "qwen-code-desktop-electron-preview",
    "artifactName": "Qwen-Code-Desktop-Electron-Preview-${version}-${arch}.${ext}",
    "asar": true,
    "beforeBuild": "scripts/electron-builder-before-build.cjs",
    "afterPack": "scripts/electron-builder-after-pack.cjs",
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/qwen-code",
        "to": "runtime/qwen-code"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "executableName": "Qwen Code Desktop Electron Preview",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png"
    },
    "publish": null
  }
}
