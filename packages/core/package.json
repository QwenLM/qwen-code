{
  "name": "@qwen-code/core",
  "version": "1.0.0",
  "description": "Qwen Code Core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenLM/qwen-code.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
