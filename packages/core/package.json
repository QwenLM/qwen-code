    "node": ">=20.18.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/src/test-utils/index.d.ts",
      "default": "./dist/src/test-utils/index.js"
    },
    "./plugin-management": {
      "types": "./dist/plugin-management.d.ts",
      "default": "./dist/plugin-management.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
