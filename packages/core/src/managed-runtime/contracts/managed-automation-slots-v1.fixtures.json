      "slots": ["2026-01-04T18:00:00Z", "2026-01-05T18:00:00Z"],
      "truncated": false
    },
    {
      "id": "etc-gmt-plus-8",
      "cron": "0 0 * * *",
      "timezone": "Etc/GMT+8",
      "after": "2026-01-04T00:00:00Z",
      "until": "2026-01-06T00:00:00Z",
      "limit": 1000,
      "note": "POSIX sign: Etc/GMT+8 is UTC-8",
      "slots": ["2026-01-04T08:00:00Z", "2026-01-05T08:00:00Z"],
      "truncated": false
    },
    {
      "id": "new-york-spring-gap-shift",
      "cron": "30 2 * * *",
      "timezone": "America/New_York",
      "after": "2026-03-07T00:00:00Z",
      "until": "2026-03-10T00:00:00Z",
      "limit": 1000,
      "note": "2026-03-08 02:30 does not exist; it fires once at 07:00Z, the first instant after the gap",
      "slots": [
        "2026-03-07T07:30:00Z",
        "2026-03-08T07:00:00Z",
        "2026-03-09T06:30:00Z"
