{
  "contract": "managed-automation-slots/1",
  "timezones": [
    "UTC",
    "Asia/Shanghai",
    "Asia/Urumqi",
    "Etc/GMT+8",
    "America/New_York",
    "Europe/Paris",
    "Australia/Lord_Howe",
    "America/Santiago",
    "Pacific/Apia"
  ],
  "rules": [
    "Slots are whole UTC minutes in (after, until]; after is exclusive and until inclusive.",
    "Each UTC minute instant is read in the zone and matched under Vixie day semantics: when neither day field starts with *, the day matches when either field does; otherwise both must.",
    "7 in the day-of-week field is Sunday; N/step runs from N to the field maximum.",
    "A wall-clock minute a DST gap skipped fires once, at the first instant after the gap.",
    "A wall-clock minute a DST fold repeats fires once, at its first instant.",
    "When the window holds more than limit slots the oldest are cut and truncated is true."
  ],
  "cases": [
    {
      "id": "utc-every-minute",
      "cron": "* * * * *",
      "timezone": "UTC",
      "after": "2026-01-05T10:00:30Z",
      "until": "2026-01-05T10:03:10Z",
      "limit": 1000,
      "note": "after is exclusive and need not be a whole minute; until is inclusive",
      "slots": [
        "2026-01-05T10:01:00Z",
        "2026-01-05T10:02:00Z",
        "2026-01-05T10:03:00Z"
      ],
      "truncated": false
    },
    {
      "id": "utc-hourly-boundary",
      "cron": "0 * * * *",
      "timezone": "UTC",
      "after": "2026-01-05T10:00:00Z",
      "until": "2026-01-05T12:00:00Z",
      "limit": 1000,
      "note": "a slot equal to after is covered; a slot equal to until fires",
      "slots": ["2026-01-05T11:00:00Z", "2026-01-05T12:00:00Z"],
      "truncated": false
    },
    {
      "id": "utc-step-from-value",
      "cron": "5/15 * * * *",
      "timezone": "UTC",
      "after": "2026-01-05T09:59:00Z",
      "until": "2026-01-05T11:00:00Z",
      "limit": 1000,
      "note": "N/step runs from N to the field maximum",
      "slots": [
        "2026-01-05T10:05:00Z",
        "2026-01-05T10:20:00Z",
        "2026-01-05T10:35:00Z",
        "2026-01-05T10:50:00Z"
      ],
      "truncated": false
    },
    {
      "id": "utc-list-and-range",
      "cron": "0 9-10,22 * * *",
      "timezone": "UTC",
      "after": "2026-01-04T23:00:00Z",
      "until": "2026-01-05T23:00:00Z",
      "limit": 1000,
      "slots": [
        "2026-01-05T09:00:00Z",
        "2026-01-05T10:00:00Z",
        "2026-01-05T22:00:00Z"
      ],
      "truncated": false
    },
    {
      "id": "utc-dow-sunday-7",
      "cron": "30 6 * * 7",
      "timezone": "UTC",
      "after": "2026-01-03T00:00:00Z",
      "until": "2026-01-12T00:00:00Z",
      "limit": 1000,
      "note": "7 is Sunday; 2026-01-04 and 2026-01-11 are Sundays",
      "slots": ["2026-01-04T06:30:00Z", "2026-01-11T06:30:00Z"],
      "truncated": false
    },
    {
      "id": "utc-vixie-or-day-fields",
      "cron": "0 0 1 * 1",
      "timezone": "UTC",
      "after": "2026-05-31T00:00:00Z",
      "until": "2026-06-09T00:00:00Z",
      "limit": 1000,
      "note": "neither day field is wild: the 1st OR a Monday (2026-06-01 is both; 2026-06-08 is a Monday)",
      "slots": ["2026-06-01T00:00:00Z", "2026-06-08T00:00:00Z"],
      "truncated": false
    },
    {
      "id": "utc-vixie-and-when-dom-wild",
      "cron": "0 0 * * 1",
      "timezone": "UTC",
      "after": "2026-05-31T00:00:00Z",
      "until": "2026-06-09T00:00:00Z",
      "limit": 1000,
      "note": "day-of-month wild: Mondays only",
      "slots": ["2026-06-01T00:00:00Z", "2026-06-08T00:00:00Z"],
      "truncated": false
    },
    {
      "id": "utc-vixie-and-when-dow-step",
      "cron": "0 0 1 * */2",
      "timezone": "UTC",
      "after": "2026-05-31T00:00:00Z",
      "until": "2026-06-09T00:00:00Z",
      "limit": 1000,
      "note": "a day-of-week field starting with * is wild: the 1st AND an even weekday (2026-06-01 is Monday=1: no fire)",
      "slots": [],
      "truncated": false
    },
    {
      "id": "utc-impossible-date",
      "cron": "0 0 31 2 *",
      "timezone": "UTC",
      "after": "2026-02-01T00:00:00Z",
      "until": "2026-03-02T00:00:00Z",
      "limit": 1000,
      "note": "never fires",
      "slots": [],
      "truncated": false
    },
    {
      "id": "utc-leap-day",
      "cron": "0 12 29 2 *",
      "timezone": "UTC",
      "after": "2028-02-28T00:00:00Z",
      "until": "2028-03-01T00:00:00Z",
      "limit": 1000,
      "slots": ["2028-02-29T12:00:00Z"],
      "truncated": false
    },
    {
      "id": "utc-limit-keeps-newest",
      "cron": "* * * * *",
      "timezone": "UTC",
      "after": "2026-01-05T10:00:00Z",
      "until": "2026-01-05T10:10:00Z",
      "limit": 3,
      "note": "the oldest slots are cut; truncated is reported",
      "slots": [
        "2026-01-05T10:08:00Z",
        "2026-01-05T10:09:00Z",
        "2026-01-05T10:10:00Z"
      ],
      "truncated": true
    },
    {
      "id": "utc-empty-window",
      "cron": "* * * * *",
      "timezone": "UTC",
      "after": "2026-01-05T10:00:00Z",
      "until": "2026-01-05T10:00:00Z",
      "limit": 10,
      "slots": [],
      "truncated": false
    },
    {
      "id": "shanghai-daily",
      "cron": "30 8 * * *",
      "timezone": "Asia/Shanghai",
      "after": "2026-01-04T00:00:00Z",
      "until": "2026-01-06T00:00:00Z",
      "limit": 1000,
      "note": "08:30 CST is 00:30Z",
      "slots": ["2026-01-04T00:30:00Z", "2026-01-05T00:30:00Z"],
      "truncated": false
    },
    {
      "id": "urumqi-fixed-offset",
      "cron": "0 0 * * *",
      "timezone": "Asia/Urumqi",
      "after": "2026-01-04T00:00:00Z",
      "until": "2026-01-06T00:00:00Z",
      "limit": 1000,
