    },
    {
      "id": "new-york-spring-gap-dedup",
      "cron": "*/15 * * * *",
      "timezone": "America/New_York",
      "after": "2026-03-08T06:30:00Z",
      "until": "2026-03-08T07:30:00Z",
      "limit": 1000,
      "note": "the four skipped quarter hours collapse into the 07:00Z slot that 03:00 EDT fires anyway",
      "slots": [
        "2026-03-08T06:45:00Z",
        "2026-03-08T07:00:00Z",
        "2026-03-08T07:15:00Z",
