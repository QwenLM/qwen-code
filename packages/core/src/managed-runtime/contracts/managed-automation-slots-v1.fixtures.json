      "timezone": "America/New_York",
      "after": "2026-03-08T06:30:00Z",
      "until": "2026-03-08T07:30:00Z",
      "limit": 1000,
      "note": "only a skipped minute matches: one slot at 07:00Z",
      "slots": ["2026-03-08T07:00:00Z"],
      "truncated": false
    },
    {
