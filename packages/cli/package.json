{
  "name": "@qwen-code/qwen-code",
  "version": "1.0.0",
  "description": "Qwen Code",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./release-notes": {
      "types": "./dist/release-notes.d.ts",
      "default": "./dist/release-notes.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "default": "./dist/acp.js"
    },
    "./framework": {
      "types": "./dist/framework.d.ts",
      "default": "./dist/framework.js"
    },
    "./daemon-host": {
      "types": "./dist/daemon-host.d.ts",
      "default": "./dist/daemon-host.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./thread-manager": {
      "types": "./dist/thread-manager.d.ts",
      "default": "./dist/thread-manager.js"
    },
    "./package.json": "./package.json",
    "./command-runtime": {
      "types": "./dist/command-runtime.d.ts",
      "default": "./dist/command-runtime.js"
    },
    "./plugin-commands": {
      "types": "./dist/plugin-commands.d.ts",
      "default": "./dist/plugin-commands.js"
    },
    "./plugin-management": {
      "types": "./dist/plugin-management.d.ts",
      "default": "./dist/plugin-management.js"
    },
    "./session-startup": {
      "types": "./dist/session-startup.d.ts",
      "default": "./dist/session-startup.js"
    },
    "./installation": {
      "types": "./dist/installation.d.ts",
      "default": "./dist/installation.js"
    },
    "./installation-host": {
      "types": "./dist/installation-host.d.ts",
      "default": "./dist/installation-host.js"
    }
  },
  "bin": {
    "qwen": "dist/bin.js"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "build:native-modifiers": "node scripts/build-native-modifiers.mjs",
    "start": "node dist/bin.js",
    "debug": "node --inspect-brk dist/bin.js",
    "format": "prettier --write .",
    "test": "vitest run --exclude '**/src/ui/**' --exclude '**/src/test-utils/**'",
    "test:ci": "cross-env QWEN_RUN_SLOW_TESTS=1 vitest run",
    "test:ui": "vitest run --include '**/src/ui/**' '**/src/test-utils/**'",
    "posttest": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@crosscopy/clipboard": "0.3.6",
    "@qwen-code/core": "file:../core",
    "@google/genai": "1.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ansi-escapes": "^7.3.0",
    "ansi-regex": "^6.2.2",
    "auto-bind": "^5.0.1",
    "bidi-js": "^1.0.3",
    "chalk": "^4.1.2",
    "cli-boxes": "^4.0.1",
    "cli-spinners": "^2.9.2",
    "clipboardy": "~5.2.0",
    "color-convert": "^2.0.1",
    "command-exists": "^1.2.9",
    "comment-json": "^4.2.5",
    "diff": "^8.0.3",
    "dotenv": "^17.1.0",
    "emoji-regex": "^10.6.0",
    "execa": "^9.6.1",
    "fzf": "^0.5.2",
    "get-east-asian-width": "^1.5.0",
    "glob": "^12.0.0",
    "highlight.js": "^11.11.1",
    "ink": "file:../ink-shim",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "latest-version": "^9.0.0",
    "lodash-es": "^4.17.21",
    "lovely-mermaid": "0.3.3",
    "lowlight": "^3.3.0",
    "marked": "^17.0.6",
    "mnemonist": "^0.40.3",
    "open": "^10.1.2",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-reconciler": "^0.32.0",
    "semver": "^7.7.2",
    "shell-quote": "^1.11.0",
    "signal-exit": "^4.1.0",
    "simple-git": "^3.28.0",
    "string-width": "^8.1.0",
    "strip-ansi": "^7.1.0",
    "strip-json-comments": "^3.1.1",
    "tar": "^7.5.8",
    "tinygradient": "^1.1.5",
    "undici": "7.29.0",
    "ws": "^8.16.0",
    "yoga-layout": "~3.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/command-exists": "^1.2.3",
    "@types/hast": "^3.0.4",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.0",
    "@types/semver": "^7.7.0",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.5.10",
    "@xterm/headless": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
