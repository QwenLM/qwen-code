exports[`Initial Theme Selection > should default to a dark theme when terminal background is dark and no theme is set 1`] = `
" Theme ·  Select  >  Apply
────────────────────────────────────────────────────────────────────────────────
 > Select Theme                                Preview
  ❯  1. Default Dark (Matches terminal)        ┌──────────────────────────────────────────────────┐
     2. ANSI Dark                              │                                                  │
     3. Atom One Dark                          │ 1 # function                                     │
     4. Ayu Dark                               │ 2 def fibonacci(n):                              │
     5. Dracula Dark                           │ 3     a, b = 0, 1                                │
     6. GitHub Dark                            │ 4     for _ in range(n):                         │
     7. Holiday Dark                           │ 5         a, b = b, a + b                        │
     8. Shades Of Purple Dark                  │ 6     return a                                   │
     9. Solarized Dark                         │                                                  │
    10. Tokyo Night Dark                       │  1  def greet(name):                             │
    11. Default Light                          │  2 -    print("Hello, " + name)                  │
  ▼ 12. ANSI Light                             │  2 +    print(f"Hello, {name}!")                 │
                                               │  3      return name                              │
                                               │                                                  │
                                               └──────────────────────────────────────────────────┘

 Tab/←→ switch · Esc back
"
`;

