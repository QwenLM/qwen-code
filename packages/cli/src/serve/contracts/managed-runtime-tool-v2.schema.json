{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwenlm.github.io/qwen-code/contracts/managed-runtime-tool-v2.schema.json",
  "title": "Managed Runtime tool v2 conformance fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "routes", "identity", "suites"],
  "properties": {
    "contractVersion": { "const": 1 },
    "routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/route" }
    },
    "identity": { "$ref": "#/$defs/identity" },
    "suites": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/suite" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "route": {
                "const": "execute"
              }
            },
            "required": ["route"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "route": {
                "const": "status"
              }
            },
            "required": ["route"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "route": {
                "const": "cancel"
              }
            },
            "required": ["route"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "method",
        "path",
        "protocolVersion",
        "requestBodyLimitBytes",
        "responseBodyLimitBytes",
        "cacheControl"
      ],
      "properties": {
        "key": { "enum": ["execute", "status", "cancel"] },
        "method": { "const": "POST" },
        "path": {
          "type": "string",
          "pattern": "^/internal/managed-runtime/v2/(execute|status|cancel)$"
        },
        "protocolVersion": { "const": 2 },
        "requestBodyLimitBytes": { "type": "integer" },
        "responseBodyLimitBytes": { "const": 1048576 },
        "cacheControl": { "const": "no-store" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "key": {
                "const": "execute"
              }
            },
            "required": ["key"]
          },
          "then": {
            "properties": {
              "requestBodyLimitBytes": {
                "const": 262144
              }
            }
          },
          "else": {
            "properties": {
              "requestBodyLimitBytes": {
                "const": 16384
              }
            }
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "leaseId", "epoch"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "epoch": { "type": "integer", "minimum": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "promptId", "callId", "argsDigest"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "promptId": { "type": "string", "minLength": 1 },
        "callId": { "type": "string", "minLength": 1 },
        "argsDigest": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionStatus", "responseParts"],
      "properties": {
        "executionStatus": {
          "enum": ["not_started", "success", "error", "cancelled"]
        },
        "responseParts": { "type": "array" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": {
            "message": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "executeRequestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "reference", "toolName", "input"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "reference": { "$ref": "#/$defs/reference" },
        "toolName": { "type": "string", "minLength": 1 },
        "input": { "type": "object" }
      }
    },
    "statusRequestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "reference"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "reference": { "$ref": "#/$defs/reference" },
        "afterSequence": { "type": "integer", "minimum": 0 }
      }
    },
    "cancelRequestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "reference"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "toolResponseBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "state"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "state": {
          "enum": [
            "prepared",
            "executing",
            "cancel_requested",
            "settled",
            "unknown"
          ]
        },
        "result": { "$ref": "#/$defs/result" },
        "lastSequence": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "state": { "not": { "const": "settled" } } },
            "required": ["state"]
          },
          "then": {
            "not": {
              "type": "object",
              "properties": { "result": true },
              "required": ["result"]
            }
          },
          "else": {
            "type": "object",
            "properties": { "result": true },
            "required": ["result"]
          }
        }
      ]
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "cache-control",
        "content-type",
        "x-qwen-managed-lease-id",
        "x-qwen-managed-lease-epoch"
      ],
      "properties": {
        "authorization": { "type": "string", "pattern": "^Bearer .+$" },
        "cache-control": { "const": "no-store" },
        "content-type": { "const": "application/json" },
        "x-qwen-managed-lease-id": { "type": "string", "minLength": 1 },
        "x-qwen-managed-lease-epoch": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": { "$ref": "#/$defs/headers" },
            "body": { "type": "object" },
            "omitHeader": { "type": "string" },
            "replaceHeader": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "value": { "type": "string" }
              }
            },
            "replaceBody": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "value": true
              }
            },
            "paddingBytes": { "type": "integer", "minimum": 1 },
            "rawBody": { "type": "string" },
            "pathSuffix": { "type": "string" },
            "pathOverride": { "type": "string" },
            "method": { "type": "string" }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "classification"],
          "properties": {
            "status": { "type": "integer", "minimum": 200, "maximum": 599 },
            "classification": {
              "enum": [
                "ok",
                "credentials",
                "protocol",
                "identity",
                "incompatible"
              ]
            },
            "code": {
              "enum": [
                "managed_runtime_attestation_invalid",
                "managed_runtime_attestation_too_large",
                "managed_runtime_identity_conflict",
                "managed_runtime_unauthorized"
              ]
            },
            "body": { "$ref": "#/$defs/toolResponseBody" }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": { "classification": { "const": "ok" } },
                "required": ["classification"]
              },
              "then": {
                "type": "object",
                "properties": { "body": true },
                "required": ["body"]
              }
            }
          ]
        }
      }
    },
    "canonicalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headers", "body"],
      "properties": {
        "headers": { "$ref": "#/$defs/headers" },
        "body": { "type": "object" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "canonicalRequest", "cases"],
      "properties": {
        "route": { "enum": ["execute", "status", "cancel"] },
        "canonicalRequest": { "$ref": "#/$defs/canonicalRequest" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case" }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "route": { "const": "execute" } },
            "required": ["route"]
          },
          "then": {
            "type": "object",
            "properties": {
              "canonicalRequest": {
                "type": "object",
                "properties": {
                  "body": { "$ref": "#/$defs/executeRequestBody" }
                }
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "type": "object",
                      "properties": {
                        "body": { "$ref": "#/$defs/executeRequestBody" }
                      }
                    },
                    "expected": {
                      "type": "object",
                      "properties": {
                        "body": {
                          "not": {
                            "type": "object",
                            "properties": { "lastSequence": true },
                            "required": ["lastSequence"]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "route": { "const": "status" } },
            "required": ["route"]
          },
          "then": {
            "type": "object",
            "properties": {
              "canonicalRequest": {
                "type": "object",
                "properties": {
                  "body": { "$ref": "#/$defs/statusRequestBody" }
                }
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "type": "object",
                      "properties": {
                        "body": { "$ref": "#/$defs/statusRequestBody" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "route": { "const": "cancel" } },
            "required": ["route"]
          },
          "then": {
            "type": "object",
            "properties": {
              "canonicalRequest": {
                "type": "object",
                "properties": {
                  "body": { "$ref": "#/$defs/cancelRequestBody" }
                }
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "type": "object",
                      "properties": {
                        "body": { "$ref": "#/$defs/cancelRequestBody" }
                      }
                    },
                    "expected": {
                      "type": "object",
                      "properties": {
                        "body": {
                          "not": {
                            "type": "object",
                            "properties": { "lastSequence": true },
                            "required": ["lastSequence"]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
