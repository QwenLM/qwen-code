{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwenlm.github.io/qwen-code/contracts/managed-runtime-tool-v2.schema.json",
  "title": "Managed Runtime tool v2 conformance fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "routes", "identity", "suites"],
  "properties": {
    "contractVersion": { "const": 1 },
    "routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/route" }
    },
    "identity": { "$ref": "#/$defs/identity" },
    "suites": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/suite" }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "method",
        "path",
        "protocolVersion",
        "requestBodyLimitBytes",
        "responseBodyLimitBytes",
        "cacheControl"
      ],
      "properties": {
        "key": { "enum": ["execute", "status", "cancel"] },
        "method": { "const": "POST" },
        "path": {
          "type": "string",
          "pattern": "^/internal/managed-runtime/v2/(execute|status|cancel)$"
        },
        "protocolVersion": { "const": 2 },
        "requestBodyLimitBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "responseBodyLimitBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "cacheControl": { "const": "no-store" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "leaseId", "epoch"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "epoch": { "type": "integer", "minimum": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "promptId", "callId", "argsDigest"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "promptId": { "type": "string", "minLength": 1 },
        "callId": { "type": "string", "minLength": 1 },
        "argsDigest": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionStatus", "responseParts"],
      "properties": {
        "executionStatus": {
          "enum": ["not_started", "success", "error", "cancelled"]
        },
        "responseParts": { "type": "array" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": {
            "message": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "toolRequestBody": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["protocolVersion", "reference"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "reference": { "$ref": "#/$defs/reference" },
        "toolName": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "afterSequence": { "type": "integer", "minimum": 0 }
      }
    },
    "toolResponseBody": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["protocolVersion", "state"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "state": {
          "enum": [
            "prepared",
            "executing",
            "cancel_requested",
            "settled",
            "unknown"
          ]
        },
        "result": { "$ref": "#/$defs/result" },
        "lastSequence": { "type": "integer", "minimum": 0 }
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "authorization",
        "cache-control",
        "content-type",
        "x-qwen-managed-lease-id",
        "x-qwen-managed-lease-epoch"
      ],
      "properties": {
        "authorization": { "type": "string", "pattern": "^Bearer .+$" },
        "cache-control": { "const": "no-store" },
        "content-type": { "const": "application/json" },
        "x-qwen-managed-lease-id": { "type": "string", "minLength": 1 },
        "x-qwen-managed-lease-epoch": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": { "type": "object" },
            "body": { "$ref": "#/$defs/toolRequestBody" },
            "omitHeader": { "type": "string" },
            "replaceHeader": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "value": { "type": "string" }
              }
            },
            "replaceBody": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "value": true
              }
            },
            "paddingBytes": { "type": "integer", "minimum": 1 },
            "rawBody": { "type": "string" },
            "pathSuffix": { "type": "string" },
            "pathOverride": { "type": "string" },
            "method": { "type": "string" }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "classification"],
          "properties": {
            "status": { "type": "integer", "minimum": 200, "maximum": 599 },
            "classification": {
              "enum": [
                "ok",
                "credentials",
                "protocol",
                "identity",
                "incompatible"
              ]
            },
            "code": { "type": "string", "minLength": 1 },
            "body": { "$ref": "#/$defs/toolResponseBody" }
          }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "canonicalRequest", "cases"],
      "properties": {
        "route": { "enum": ["execute", "status", "cancel"] },
        "canonicalRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headers", "body"],
          "properties": {
            "headers": { "$ref": "#/$defs/headers" },
            "body": { "$ref": "#/$defs/toolRequestBody" }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case" }
        }
      }
    }
  }
}
