{
  "name": "@qwen-code/browser-use",
  "version": "0.1.0",
  "description": "Browser Use SDK for the Qwen Code Node REPL",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenLM/qwen-code.git",
    "directory": "packages/browser-use"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/core/primitives.d.ts",
    "dist/sdk/types.d.ts",
    "dist/native-host.js",
    "dist/scripts/native-host-setup.js",
    "skills",
    "qwen-extension.json",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.declarations.json",
    "native-host:install": "node dist/scripts/native-host-setup.js install",
    "native-host:status": "node dist/scripts/native-host-setup.js status",
    "native-host:uninstall": "node dist/scripts/native-host-setup.js uninstall",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "playwright-core": "1.62.1"
  },
  "bundledDependencies": [
    "playwright-core"
  ]
}
