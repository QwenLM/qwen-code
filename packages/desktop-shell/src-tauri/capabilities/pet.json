{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet",
  "description": "Allows the bundled desktop pet renderer to receive settings and activity updates.",
  "windows": ["pet"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-pet-bootstrap",
    "allow-start-pet-dragging",
    "allow-close-desktop-pet"
  ]
}
