{
  "name": "@qwen-code/core",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "Qwen Code Core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/google-gemini/gemini-cli.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ../scripts/build_package.js",
    "format": "prettier --write .",
    "test:harness": "vitest run",
    "test:harness:ci": "cross-env QWEN_RUN_SLOW_TESTS=1 vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@qwen-code/resource": "file:../resource",
    "@anthropic-ai/sdk": "^0.81.0",
    "@google/genai": "1.30.0",
    "@lydell/node-pty": "1.1.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.211.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-logs": "^0.211.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@xterm/headless": "^5.5.0",
    "acorn": "^8.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.0",
    "chardet": "^2.1.0",
    "chokidar": "^4.0.3",
    "diff": "^8.0.3",
    "dotenv-expand": "^12.0.3",
    "fast-levenshtein": "^2.0.6",
    "fdir": "^6.4.6",
    "fflate": "^0.8.2",
    "fzf": "^0.5.2",
    "glob": "^12.0.0",
    "ignore": "^7.0.0",
    "ipaddr.js": "^1.9.1",
    "js-yaml": "^4.1.1",
    "json-stable-stringify": "^1.3.0",
    "jsonc-parser": "^3.3.1",
    "lru-cache": "^10.4.3",
    "marked": "^15.0.12",
    "mime": "4.0.7",
    "openai": "^6.49.0",
    "picomatch": "^4.0.1",
    "proper-lockfile": "^4.1.2",
    "quickjs-wasi": "3.6.2",
    "read-package-up": "^11.0.0",
    "sharp": "^0.34.5",
    "shell-quote": "^1.11.0",
    "string-width": "^8.1.0",
    "strip-ansi": "^7.1.0",
    "strip-json-comments": "^3.1.1",
    "tree-kill": "^1.2.2",
    "tree-sitter-bash": "^0.25.0",
    "turndown": "^7.2.4",
    "undici": "7.29.0",
    "web-tree-sitter": "^0.25.10",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/json-stable-stringify": "^1.1.0",
    "@types/node": "^20.11.24",
    "@types/picomatch": "^4.0.1",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "^3.4.0",
    "jszip": "^3.10.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/src/test-utils/index.d.ts",
      "default": "./dist/src/test-utils/index.js"
    },
    "./plugin-management": {
      "types": "./dist/plugin-management.d.ts",
      "default": "./dist/plugin-management.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./process-guard": {
      "types": "./dist/process-guard.d.ts",
      "default": "./dist/process-guard.js"
    },
    "./*": "./*"
  }
}
